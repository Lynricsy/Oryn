{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["vite/client"],
		"paths": { "oryn:design": ["./oryn-design.tsx"] }
	},
	"include": ["main.tsx", "oryn-design.tsx", "src", "vite.config.ts"]
}
