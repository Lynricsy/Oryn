# 示例：Oryn 管理页「更多 -> Agent -> 记忆 -> 生成 .env」的输出格式（值为占位）。
# 不要手写这个文件：真实的 .env 由管理页生成，两个密钥只显示一次；键集由 internal/memory 的 TestEnvExample 校验。
# 鉴权：请求必须带 Authorization: Bearer <API key>（只有 orynd 持有）
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=hsk_<64 位十六进制>
# 固定 worker ID（issue #2165）、中文检索、输出语言与并发上限
HINDSIGHT_API_WORKER_ID=oryn-1
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=pgroonga
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=Simplified Chinese
HINDSIGHT_API_LLM_MAX_CONCURRENT=4
HINDSIGHT_API_WORKER_MAX_SLOTS=4
# 模型：每种用途写固定别名，经 orynd 中转替换成管理页选定的真实模型
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=oryn-default
HINDSIGHT_API_LLM_BASE_URL=https://oryn.example.com/memory-relay/v1/default
HINDSIGHT_API_LLM_API_KEY=omr_<64 位十六进制>
HINDSIGHT_API_RETAIN_LLM_PROVIDER=openai
HINDSIGHT_API_RETAIN_LLM_MODEL=oryn-retain
HINDSIGHT_API_RETAIN_LLM_BASE_URL=https://oryn.example.com/memory-relay/v1/retain
HINDSIGHT_API_RETAIN_LLM_API_KEY=omr_<64 位十六进制>
HINDSIGHT_API_REFLECT_LLM_PROVIDER=openai
HINDSIGHT_API_REFLECT_LLM_MODEL=oryn-reflect
HINDSIGHT_API_REFLECT_LLM_BASE_URL=https://oryn.example.com/memory-relay/v1/reflect
HINDSIGHT_API_REFLECT_LLM_API_KEY=omr_<64 位十六进制>
HINDSIGHT_API_CONSOLIDATION_LLM_PROVIDER=openai
HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=oryn-consolidation
HINDSIGHT_API_CONSOLIDATION_LLM_BASE_URL=https://oryn.example.com/memory-relay/v1/consolidation
HINDSIGHT_API_CONSOLIDATION_LLM_API_KEY=omr_<64 位十六进制>
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_PROVIDER=openai
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MODEL=oryn-mental-model
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_BASE_URL=https://oryn.example.com/memory-relay/v1/mental_model
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_API_KEY=omr_<64 位十六进制>
# gemini 协议只认这个进程级地址（忽略各用途的 BASE_URL），中转按 URL 里的别名认出用途
GOOGLE_GEMINI_BASE_URL=https://oryn.example.com/memory-relay/v1/gemini
# 嵌入（OpenAI 兼容）与重排（Cohere 兼容）同样经 orynd 中转
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://oryn.example.com/memory-relay/v1/embed
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=omr_<64 位十六进制>
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=oryn-embed
HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024
HINDSIGHT_API_RERANKER_PROVIDER=cohere
HINDSIGHT_API_RERANKER_COHERE_BASE_URL=https://oryn.example.com/memory-relay/v1/rerank/v1/rerank
HINDSIGHT_API_RERANKER_COHERE_API_KEY=omr_<64 位十六进制>
HINDSIGHT_API_RERANKER_COHERE_MODEL=oryn-rerank
