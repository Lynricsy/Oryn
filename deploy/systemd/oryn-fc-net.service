[Unit]
Description=Oryn Firecracker 宿主网络（oryn-fc 接口、nft 表 inet oryn_fc / ip oryn_fc_nat）
# orynd 要监听 host_addr（172.31.255.1），这个地址必须先于 orynd 存在。
# 排在 docker 之后：DOCKER-USER 链由 Docker 创建，有它时脚本才追加 fc-* 的放行。
After=network-online.target docker.service
Wants=network-online.target
Before=orynd.service oryn-provider-fc.service

[Service]
Type=oneshot
RemainAfterExit=yes
# guest 可连的 host_addr 端口。Firecracker orb 的 link 默认走 TLS（orb_url = https://172.31.255.1:7643，
# 对应 orynd 的 orb_tls.listen），默认只放行 7643；没开 orb_tls 的部署改成 "7600"（明文 listen），或两个都写 "7600,7643"。
# 端口须包含 provider.yaml 的 orb_url 端口（oryn provider preflight 会核对）。
Environment=ORYN_FC_LINK_PORTS=7643
# 与 provider.yaml 的 firecracker.network 保持一致（以下为默认值）。
Environment=ORYN_FC_CIDR=172.31.0.0/16
Environment=ORYN_FC_HOST_ADDR=172.31.255.1
ExecStart=/usr/local/lib/oryn/oryn-fc-net.sh up
ExecStop=/usr/local/lib/oryn/oryn-fc-net.sh down

[Install]
WantedBy=multi-user.target
