  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -b && vite build && vite build -c vite.sandbox.config.ts && vite build -c vite.sandbox.config.ts --mode overview && vite build -c vite.sandbox.config.ts --mode viewer-document && vite build -c vite.sandbox.config.ts --mode viewer-slides && vite build -c vite.sandbox.config.ts --mode beacon",
    "build:launcher": "tsc -b && vite build --mode launcher",
    "preview": "vite preview",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../schema/openapi.yaml -o src/api/schema.d.ts",
    "shots": "bun scripts/screenshots.ts",
