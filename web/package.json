{
  "name": "oryn-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "build:launcher": "tsc -b && vite build --mode launcher",
    "preview": "vite preview",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../schema/openapi.yaml -o src/api/schema.d.ts",
    "shots": "bun scripts/screenshots.ts",
    "shots:m25": "bun scripts/screenshots.ts --m25",
    "shots:all": "bun scripts/screenshots.ts --all",
    "accept:m3": "bun scripts/m3-accept.ts",
    "accept:m4": "bun scripts/m4-accept.ts",
    "accept:m5": "bun scripts/m5-accept.ts",
    "accept:m6": "dbus-run-session -- xvfb-run -a -s '-screen 0 1440x900x24' bun scripts/m6-accept.ts",
    "accept:m7": "bun scripts/m7-accept.ts",
    "accept:m8": "bun scripts/m8-accept.ts",
    "accept:m9": "bun scripts/m9-accept.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@novnc/novnc": "1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "i18next": "^27.1.1",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uqr": "^0.1.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
