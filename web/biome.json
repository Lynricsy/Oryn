{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!dist", "!src/api/schema.d.ts", "!src/omp"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["package.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/tool-render/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noArrayIndexKey": "off",
						"noControlCharactersInRegex": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					},
					"a11y": {
						"useAriaPropsSupportedByRole": "off"
					}
				}
			}
		}
	]
}
