{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oryn",
  "mainBinaryName": "oryn-desktop",
  "identifier": "com.lynricsy.oryn",
  "build": {
    "frontendDist": "../dist-launcher",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Oryn desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "android": {
      "minSdkVersion": 33
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "oryn"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "oryn"
          ],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMkUzODZFNzNFMzExOEYKUldTUEVlTnpiamd1L2svOWlCdFRGeHF6RVJBZisvTnhFL1ZJY0NxN0kzd0l3TXl2RTlzTUFoL0MK",
      "endpoints": [
        "https://github.com/Lynricsy/Oryn/releases/download/desktop-updater/latest.json"
      ]
    }
  }
}
